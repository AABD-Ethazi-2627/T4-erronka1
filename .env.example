# Solo para importar una instalacion existente con scripts/security.py init --import-env .env.
# En instalaciones nuevas, security.py init genera los secretos cifrados directamente.
# El despliegue ya no utiliza .env: consulta SECURITY.md.
NIFI_USERNAME=cncadmin
# NiFi requiere un minimo de 12 caracteres. Usa al menos 24 aleatorios.
NIFI_PASSWORD=
# Conservado como referencia: el volumen CIFS actual no utiliza CSV_DIR.
CSV_DIR=/mnt/cnc-stream
SMB_USERNAME=
SMB_PASSWORD=
MONGO_USERNAME=mongoadmin
MONGO_PASSWORD=
